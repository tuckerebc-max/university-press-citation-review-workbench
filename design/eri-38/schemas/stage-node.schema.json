            "CE",
            "SEI",
            "CPR",
            "PPR",
            "EQA"
          ]
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "chapter",
            "volume",
            "batch"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hard_preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expected_output": {
          "type": "string",
