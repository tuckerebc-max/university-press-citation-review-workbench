{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "university_press.reply.draft1"
    },
    "verb": {
      "enum": [
        "declare",
        "plan",
        "seal",
        "review",
        "reconcile",
        "record-decision",
        "inspect",
        "conform"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "ok",
        "technical_failure",
        "refused"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "object_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "rule_id",
          "object_ref",
          "retryable"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "verb",
    "request_id",
    "outcome",
    "result",
    "errors",
    "unknowns",
    "receipt_ref"
  ]
}
