{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "capture_uri",
        "sha256"
      ]
    },
    "expected_object_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "receipt",
    "expected_object_sha256"
  ]
}
