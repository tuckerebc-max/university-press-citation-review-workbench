{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "capture_uri",
        "sha256"
      ]
    },
    "seal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capture_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "capture_uri",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capture_uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "capture_uri",
          "sha256"
        ]
      }
    },
    "event_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "design_simulation",
        "diagnostic_review"
      ]
    }
  },
  "required": [
    "plan",
    "seal",
    "result_refs",
    "event_head",
    "mode"
  ]
}
