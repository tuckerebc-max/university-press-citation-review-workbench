{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "university_press.family_result.draft1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "enum": [
        "RCI",
        "SGI",
        "TE",
        "CE",
        "SEI",
        "CPR",
        "PPR",
        "EQA"
      ]
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "chapter",
            "volume",
            "batch"
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "ids"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_map": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_bundle": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "specification": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "format_targets": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "manifest",
        "capability_map",
        "profile",
        "source_bundle",
        "rules",
        "policy",
        "route",
        "specification",
        "lock",
        "authority",
        "format_targets",
        "baseline",
        "proof"
      ]
    },
    "binding_states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "capability_map": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "profile": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "source_bundle": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "rules": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "policy": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "route": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "specification": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "lock": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "authority": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "format_targets": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "baseline": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "proof": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "manifest",
        "capability_map",
        "profile",
        "source_bundle",
        "rules",
        "policy",
        "route",
        "specification",
        "lock",
        "authority",
        "format_targets",
        "baseline",
        "proof"
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "blocked",
        "inconclusive"
      ]
    },
    "family_status": {
      "type": "string",
      "minLength": 1
    },
    "release_effect": {
      "enum": [
        "none",
        "track",
        "hold",
        "block"
      ]
    },
    "package_maturity": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "unknown",
        "absent"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "known",
        "unknown",
        "not_applicable",
        "total",
        "unknowns"
      ]
    },
    "capture_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "critical_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_run"
            ]
          }
        },
        "required": [
          "case_id",
          "status"
        ]
      }
    },
    "findings_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_payload_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_payload_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_ref": {
      "type": "string",
      "minLength": 1
    },
    "surface_ref": {
      "type": "string",
      "minLength": 1
    },
    "attempt_ref": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reserved_decisions_performed": {
      "const": false
    }
  },
  "required": [
    "schema",
    "result_id",
    "plan_id",
    "node_id",
    "family_id",
    "scope_ref",
    "bindings",
    "binding_states",
    "outcome",
    "family_status",
    "release_effect",
    "package_maturity",
    "coverage",
    "capture_uris",
    "critical_results",
    "findings_ref",
    "native_payload_ref",
    "native_payload_sha256",
    "worker_ref",
    "surface_ref",
    "attempt_ref",
    "limitations",
    "reserved_decisions_performed"
  ]
}
