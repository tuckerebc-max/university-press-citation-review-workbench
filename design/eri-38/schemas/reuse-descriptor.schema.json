{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prior_result_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prior_plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "enum": [
        "chapter",
        "volume",
        "batch"
      ]
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unchanged_dependency_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "prior_result_id",
    "prior_plan_id",
    "scope",
    "scope_ids",
    "unchanged_dependency_sha256",
    "evidence_refs"
  ]
}
