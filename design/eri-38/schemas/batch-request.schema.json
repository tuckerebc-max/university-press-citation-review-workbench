{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "university_press.batch_request.draft1"
    },
    "stage_profile": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classification": {
      "enum": [
        "synthetic",
        "public",
        "internal",
        "restricted"
      ]
    },
    "mode": {
      "enum": [
        "design_simulation",
        "diagnostic_review"
      ]
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "volume_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "source_capture_uri": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20971520
          }
        },
        "required": [
          "chapter_id",
          "volume_id",
          "order",
          "source_capture_uri",
          "source_sha256",
          "bytes"
        ]
      }
    },
    "context_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "source_permissions": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "stage_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "rules",
        "source_permissions",
        "policy",
        "stage_inputs"
      ]
    },
    "authority_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dock_lineage": {
          "type": [
            "string",
            "null"
          ]
        },
        "G0": {
          "type": [
            "string",
            "null"
          ]
        },
        "G1": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_approval": {
          "type": [
            "string",
            "null"
          ]
        },
        "pin_approval": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dock_lineage",
        "G0",
        "G1",
        "route_approval",
        "pin_approval"
      ]
    },
    "output_root_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "stage_profile",
    "manifest_sha256",
    "classification",
    "mode",
    "chapters",
    "context_refs",
    "authority_refs",
    "output_root_ref"
  ]
}
